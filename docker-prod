if docker-compose -f provisioning/docker-compose.yml -f provisioning/docker-compose.prod.yml --project-name kamailio "$@" 
then
  echo ""
  echo "-----------------------"
  read -p "Push to production? Enter A for Being Awesome: " yn
  case $yn in
    [Aa]* ) docker push signalwire/kamailio; break;;
    * ) exit;;
  esac
fi